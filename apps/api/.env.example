DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=4000
# Set true only when the API sits behind one reverse proxy (Render, nginx).
# The office-network check uses that proxy's client IP. Leave false when the API is reached directly.
TRUST_PROXY=false
CORS_ORIGIN="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/calendar/callback"

# Microsoft Entra app (mail + company sign-in)
# Redirect URI (Web): http://localhost:4000/api/v1/auth/microsoft/callback
# Delegated: openid, profile, email, offline_access, User.Read, Calendars.ReadWrite, Tasks.Read, Tasks.ReadWrite
# Add delegated Tasks.Read and Tasks.ReadWrite on the Entra app, then reconnect Microsoft so Planner edits work.
# Application (mail only): Mail.Send + admin consent
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_REDIRECT_URI="http://localhost:4000/api/v1/auth/microsoft/callback"
MS_MAIL_FROM="connect@aithworld.com"

# Fallback SMTP (often blocked by Security Defaults)
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="connect@aithworld.com"
SMTP_PASS=""
SMTP_FROM="Go Staff Careers <connect@aithworld.com>"
CAREERS_PUBLIC_URL="http://localhost:3000/careers"

# Supabase Storage for onboarding documents (bucket name is intentional)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="Onborading_docs"
