generator client {
  provider        = "prisma-client-js"
  output          = "../../node_modules/@prisma/platform-client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform"]
}

model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@schema("platform")
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  schemaName  String   @unique
  hosts       String[]
  databaseUrl String?
  ownerEmail  String
  mailFrom    String?
  createdAt   DateTime @default(now())

  @@schema("platform")
}
