generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  OWNER
  MANAGEMENT
  HR
  DEPT_MANAGER
  TEAM_LEADER
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  WFH
  HOLIDAY
  LEAVE
  PENDING_APPROVAL
  REJECTED
}

enum AttendanceApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CLARIFICATION
  CANCELLED
}

enum LeaveFrequency {
  YEARLY
  MONTHLY
  QUARTERLY
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
  COMPLETED_ON_TIME
  COMPLETED_LATE
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_EMPLOYEE
  RESOLVED
  CLOSED
}

enum TicketCategory {
  IT
  HR
  ACCOUNTS
  PAYROLL
  ADMIN
  FACILITY
  OTHER
}

enum SuggestionStatus {
  NEW
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  IMPLEMENTED
}

enum InvoiceStatus {
  GENERATED
  PAID
  PENDING
  OVERDUE
  PARTIAL
}

enum LeadStatus {
  NEW
  FOLLOW_UP
  CONVERTED
  LOST
  PENDING
}

enum OrderStatus {
  NEW
  OPEN
  PROCESSING
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
  DELAYED
  PENDING
}

enum ExternalSourceType {
  SALES
  ACCOUNTS
  REVENUE
  OPERATIONS
}

enum IngestJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum HolidayType {
  PUBLIC
  COMPANY
  OPTIONAL
  FESTIVAL
}

enum RecruitmentStatus {
  OPEN
  INTERVIEWING
  FILLED
  CANCELLED
  DELAYED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum OnboardingStatus {
  PENDING_OWNER
  OFFER_LETTER
  DOCUMENTS
  CREATE_ACCOUNT
  IT_HR_CHECKLIST
  COMPLETED
  REJECTED
  CANCELLED
}

enum OffboardingStatus {
  PENDING_OWNER
  EXIT_CLEARANCE
  FINAL_DOCUMENTS
  REVOKE_ACCESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum LifecycleDocumentKind {
  ID_PROOF
  ADDRESS
  BANK
  EDUCATION
  PREVIOUS_PAYSLIP
  FINAL_PAYSLIP
  OFFER_LETTER
  RELIEVING_LETTER
  EXPERIENCE_LETTER
  PHOTO
  OTHER
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
  positions JobPosition[]
  leaveAllocations LeaveAllocation[]
}

model Designation {
  id        String        @id @default(cuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  employees Employee[]
  positions JobPosition[]
}

model Role {
  id          String           @id @default(cuid())
  code        RoleCode         @unique
  name        String
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id       String @id @default(cuid())
  roleId   String
  resource String
  action   String
  allowed  Boolean @default(true)
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  employee     Employee?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[] @relation("AuditActor")
  notifications Notification[]
  attendanceDecisions Attendance[] @relation("AttendanceApprover")
  onboardingRequested  OnboardingRequest[]  @relation("OnboardingRequester")
  onboardingApproved   OnboardingRequest[]  @relation("OnboardingApprover")
  offboardingRequested OffboardingRequest[] @relation("OffboardingRequester")
  offboardingApproved  OffboardingRequest[] @relation("OffboardingApprover")
  microsoftAccount     MicrosoftAccount?
}

model EmployeeCodeSequence {
  id         String @id @default("default")
  lastIssued Int    @default(0)
}

model Employee {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String       @unique
  firstName        String
  lastName         String
  gender           Gender?
  dateOfBirth      DateTime?
  bloodGroup       BloodGroup?
  maritalStatus    MaritalStatus?
  fatherOrSpouseName String?
  phone            String?
  alternatePhone   String?
  personalEmail    String?
  photoUrl         String?
  currentAddress   String?
  city             String?
  state            String?
  pincode          String?
  permanentAddress String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  aadhaarNumber    String?
  panNumber        String?
  joiningDate      DateTime
  employmentType   EmploymentType @default(FULL_TIME)
  workLocation     String?
  bankName         String?
  bankAccountNumber String?
  bankIfsc         String?
  departmentId     String?
  department       Department?  @relation(fields: [departmentId], references: [id])
  designationId    String?
  designation      Designation? @relation(fields: [designationId], references: [id])
  managerId        String?
  manager          Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports          Employee[]   @relation("EmployeeManager")
  lastWorkingDay   DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  attendance       Attendance[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[] @relation("LeaveApplicant")
  leaveApprovals   LeaveRequest[] @relation("LeaveApprover")
  assignedTasks    Task[]         @relation("TaskAssignee")
  createdTasks     Task[]         @relation("TaskAssignor")
  performanceScores PerformanceScore[]
  tickets          Ticket[]       @relation("TicketRequester")
  assignedTickets  Ticket[]       @relation("TicketAssignee")
  suggestions      Suggestion[]
  salespersonMetrics SalespersonMetric[]
  leads            Lead[]
  onboardingRequests  OnboardingRequest[]
  offboardingRequests OffboardingRequest[]
  documents           LifecycleDocument[]
  leaveAllocations    LeaveAllocation[]
}

model AttendancePolicy {
  id                      String   @id @default("default")
  officeLatitude          Float?
  officeLongitude         Float?
  allowedRadiusMeters     Int      @default(100)
  authorizedIps           String[] @default([])
  requireLocation         Boolean  @default(true)
  requireNetwork          Boolean  @default(true)
  hrApprovalForExceptions Boolean  @default(true)
  shiftStart              String?
  shiftEnd                String?
  weekOffDays             Int[]    @default([0, 6])
  updatedAt               DateTime @updatedAt
}

model Attendance {
  id                 String                   @id @default(cuid())
  employeeId         String
  employee           Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date               DateTime
  checkIn            DateTime?
  checkOut           DateTime?
  status             AttendanceStatus         @default(PRESENT)
  workingMinutes     Int?
  overtimeMinutes    Int                      @default(0)
  notes              String?
  latitude           Float?
  longitude          Float?
  locationAccuracy   Float?
  locationCapturedAt DateTime?
  officeDistance     Float?
  locationVerified   Boolean                  @default(false)
  publicIp           String?
  networkVerified    Boolean                  @default(false)
  approvalStatus     AttendanceApprovalStatus @default(NOT_REQUIRED)
  exceptionReason       String?
  missedClockOutReason String?
  proposedCheckOut     DateTime?
  approvedById          String?
  approvedBy         User?                    @relation("AttendanceApprover", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([approvalStatus])
}

model LeaveType {
  id                 String            @id @default(cuid())
  name               String            @unique
  code               String            @unique
  days               Int               @default(12)
  annualAllocation   Int               @default(12)
  frequency          LeaveFrequency    @default(YEARLY)
  paid               Boolean           @default(true)
  carryForward       Boolean           @default(false)
  maxCarryDays       Int               @default(0)
  maxConsecutiveDays Int?
  minNoticeDays      Int               @default(0)
  requiresDocument   Boolean           @default(false)
  active             Boolean           @default(true)
  description        String?
  balances           LeaveBalance[]
  requests           LeaveRequest[]
  allocations        LeaveAllocation[]
}

model LeaveAllocation {
  id           String      @id @default(cuid())
  leaveTypeId  String
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  days         Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([leaveTypeId, departmentId])
  @@unique([leaveTypeId, employeeId])
  @@index([leaveTypeId])
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  allocated   Int
  used        Int       @default(0)
  remaining   Int

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation("LeaveApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime   
  endDate     DateTime   
  reason      String
  attachmentUrl String?
  status      LeaveStatus @default(PENDING)
  approverId  String?
  approver    Employee?   @relation("LeaveApprover", fields: [approverId], references: [id])
  reviewNote  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Holiday {
  id          String      @id @default(cuid())
  name        String
  date        DateTime   
  type        HolidayType @default(PUBLIC)
  description String?
  createdAt   DateTime    @default(now())
}

model Policy {
  id           String   @id @default(cuid())
  title        String
  category     String
  description  String
  documentUrl  String?
  version      String   @default("1.0")
  effectiveDate DateTime
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  pinned    Boolean   @default(false)
  expiresAt DateTime?
  attachmentUrl String?
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model CompanyContact {
  id        String  @id @default(cuid())
  name      String
  role      String?
  department String?
  phone     String?
  email     String?
  isEmergency Boolean @default(false)
}

model SocialLink {
  id       String @id @default(cuid())
  platform String
  url      String
  order    Int    @default(0)
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  assigneeId  String
  assignee    Employee   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignorId  String
  assignor    Employee   @relation("TaskAssignor", fields: [assignorId], references: [id])
  isChecklist Boolean    @default(false)
  checklistItems ChecklistItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([assigneeId])
}

model ChecklistItem {
  id        String  @id @default(cuid())
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean @default(false)
  order     Int     @default(0)
}

model PerformanceScore {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  taskCompletion  Float
  attendance      Float
  timeliness      Float
  productivity    Float
  overall         Float
  createdAt       DateTime @default(now())

  @@index([employeeId, periodStart])
}

model Ticket {
  id          String         @id @default(cuid())
  subject     String
  description String
  category    TicketCategory
  priority    String         @default("MEDIUM")
  status      TicketStatus   @default(OPEN)
  attachmentUrl String?
  requesterId String
  requester   Employee       @relation("TicketRequester", fields: [requesterId], references: [id])
  assigneeId  String?
  assignee    Employee?      @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Suggestion {
  id          String           @id @default(cuid())
  subject     String
  category    String
  description String
  attachmentUrl String?
  isAnonymous Boolean          @default(false)
  status      SuggestionStatus @default(NEW)
  authorId    String?
  author      Employee?        @relation(fields: [authorId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model JobPosition {
  id                  String            @id @default(cuid())
  title               String
  slug                String?           @unique
  description         String?
  location            String?
  employmentType      EmploymentType    @default(FULL_TIME)
  salaryRange         String?
  requirements        String?
  isPublic            Boolean           @default(true)
  publishedAt         DateTime?
  departmentId        String?
  department          Department?       @relation(fields: [departmentId], references: [id])
  designationId       String?
  designation         Designation?      @relation(fields: [designationId], references: [id])
  openingDate         DateTime
  targetHireDate      DateTime
  actualHireDate      DateTime?
  status              RecruitmentStatus @default(OPEN)
  applicantsCount     Int               @default(0)
  interviewsScheduled Int               @default(0)
  interviewsCompleted Int               @default(0)
  selectedCount       Int               @default(0)
  rejectedCount       Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  applications        JobApplication[]
}

model JobApplication {
  id                String            @id @default(cuid())
  positionId        String
  position          JobPosition       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  fullName          String
  email             String
  phone             String?
  resumeUrl         String?
  coverLetter       String?
  linkedInUrl       String?
  experienceYears   Float?
  currentCompany    String?
  status            ApplicationStatus @default(APPLIED)
  hrNotes           String?
  interviewAt       DateTime?
  interviewLocation String?
  lastEmailAt       DateTime?
  lastEmailSubject  String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  onboardingRequests OnboardingRequest[]

  @@index([positionId])
  @@index([email])
  @@index([status])
}

model ExternalSource {
  id        String             @id @default(cuid())
  name      String
  type      ExternalSourceType
  apiKeyHash String
  apiKeyPrefix String
  isActive  Boolean            @default(true)
  lastSyncAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  ingestJobs IngestJob[]
  leads     Lead[]
  invoices  Invoice[]
  financialSnapshots FinancialSnapshot[]
  orders    Order[]
  salespersonMetrics SalespersonMetric[]
}

model IngestJob {
  id            String          @id @default(cuid())
  sourceId      String?
  source        ExternalSource? @relation(fields: [sourceId], references: [id])
  domain        String
  method        String
  status        IngestJobStatus @default(PENDING)
  totalRows     Int             @default(0)
  successRows   Int             @default(0)
  failedRows    Int             @default(0)
  errors        Json?
  createdById   String?
  createdAt     DateTime        @default(now())
  completedAt   DateTime?
}

model Lead {
  id           String      @id @default(cuid())
  externalId   String
  sourceId     String?
  source       ExternalSource? @relation(fields: [sourceId], references: [id])
  name         String?
  email        String?
  phone        String?
  status       LeadStatus  @default(NEW)
  leadSource   String?
  salespersonId String?
  salesperson  Employee?   @relation(fields: [salespersonId], references: [id])
  revenue      Float       @default(0)
  syncedAt     DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([sourceId, externalId])
  @@index([status])
}

model SalespersonMetric {
  id              String   @id @default(cuid())
  externalId      String
  sourceId        String?
  source          ExternalSource? @relation(fields: [sourceId], references: [id])
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id])
  salespersonName String
  weekStart       DateTime
  leadsAssigned   Int      @default(0)
  leadsContacted  Int      @default(0)
  leadsConverted  Int      @default(0)
  revenueGenerated Float   @default(0)
  target          Float    @default(0)
  syncedAt        DateTime @default(now())

  @@unique([sourceId, externalId])
}

model FinancialSnapshot {
  id         String   @id @default(cuid())
  externalId String
  sourceId   String?
  source     ExternalSource? @relation(fields: [sourceId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  vertical   String?
  revenue    Float    @default(0)
  grossProfit Float   @default(0)
  netProfit  Float    @default(0)
  expenses   Float    @default(0)
  margin     Float    @default(0)
  syncedAt   DateTime @default(now())

  @@unique([sourceId, externalId])
  @@index([periodStart, periodEnd])
}

model Invoice {
  id            String        @id @default(cuid())
  externalId    String
  sourceId      String?
  source        ExternalSource? @relation(fields: [sourceId], references: [id])
  invoiceNumber String
  customerName  String?
  amount        Float
  paidAmount    Float         @default(0)
  status        InvoiceStatus @default(PENDING)
  issueDate     DateTime     
  dueDate       DateTime     
  paidDate      DateTime?    
  syncedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([sourceId, externalId])
  @@index([dueDate, status])
}

model Order {
  id              String      @id @default(cuid())
  externalId      String
  sourceId        String?
  source          ExternalSource? @relation(fields: [sourceId], references: [id])
  orderNumber     String
  customerName    String?
  status          OrderStatus @default(NEW)
  orderDate       DateTime   
  promisedDate    DateTime?  
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  isOnTime        Boolean?
  syncedAt        DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([sourceId, externalId])
  @@index([status])
}

model CalendarToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String?
  expiryDate   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MicrosoftAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String   @default("")
  expiresAt    DateTime
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  sourceId  String?
  url       String
  secret    String
  domain    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AlertRule {
  id          String   @id @default(cuid())
  name        String
  type        String
  threshold   Float?
  isActive    Boolean  @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime @default(now())
}

model OnboardingRequest {
  id               String           @id @default(cuid())
  status           OnboardingStatus @default(PENDING_OWNER)
  firstName        String
  lastName         String
  email            String
  phone            String?
  employeeCode     String?
  roleCode         String           @default("EMPLOYEE")
  joiningDate      DateTime
  departmentId     String?
  designationId    String?
  managerId        String?
  applicationId    String?
  profile          Json?
  application      JobApplication? @relation(fields: [applicationId], references: [id])
  employeeId       String?
  employee         Employee?        @relation(fields: [employeeId], references: [id])
  requestedById    String
  requestedBy      User             @relation("OnboardingRequester", fields: [requestedById], references: [id])
  ownerApproverId  String?
  ownerApprover    User?            @relation("OnboardingApprover", fields: [ownerApproverId], references: [id])
  reviewNote       String?
  offerSubject     String?
  offerBody        String?
  offerSentAt      DateTime?
  offerAcceptedAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  documents        LifecycleDocument[]
  checklistItems   LifecycleChecklistItem[]

  @@index([status])
  @@index([email])
}

model OffboardingRequest {
  id               String            @id @default(cuid())
  status           OffboardingStatus @default(PENDING_OWNER)
  employeeId       String
  employee         Employee          @relation(fields: [employeeId], references: [id])
  lastWorkingDay   DateTime
  reason           String
  requestedById    String
  requestedBy      User              @relation("OffboardingRequester", fields: [requestedById], references: [id])
  ownerApproverId  String?
  ownerApprover    User?             @relation("OffboardingApprover", fields: [ownerApproverId], references: [id])
  reviewNote       String?
  accessRevokedAt  DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  documents        LifecycleDocument[]
  checklistItems   LifecycleChecklistItem[]

  @@index([status])
  @@index([employeeId])
}

model LifecycleDocument {
  id            String                @id @default(cuid())
  kind          LifecycleDocumentKind @default(OTHER)
  title         String
  url           String
  storagePath   String?
  mimeType      String?
  fileName      String?
  uploadedAt    DateTime              @default(now())
  onboardingId  String?
  onboarding    OnboardingRequest?    @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  offboardingId String?
  offboarding   OffboardingRequest?   @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
  employeeId    String?
  employee      Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([onboardingId])
  @@index([offboardingId])
  @@index([employeeId])
}

model LifecycleChecklistItem {
  id            String              @id @default(cuid())
  title         String
  completed     Boolean             @default(false)
  order         Int                 @default(0)
  onboardingId  String?
  onboarding    OnboardingRequest?  @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  offboardingId String?
  offboarding   OffboardingRequest? @relation(fields: [offboardingId], references: [id], onDelete: Cascade)

  @@index([onboardingId])
  @@index([offboardingId])
}
